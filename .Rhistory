# Keep only these columns
filtered_data <- combined %>%
select(L.ID, lists, COMMON, SCIENTIFIC, LATITUDE, LONGITUDE, geometry, DATE, O.COUNT,
OBSERV.ID, SEI, MONTH, Shape_Area, Park_Addre, Park_Size_, Park_Size1, Park_Siz_1,
species_richness, first_system.index, first_GISTrkrID, first_ParkID,
first_.geo, first_mean)
ggplot(filtered_data, aes(x = species_richness, y = O.COUNT)) +
geom_point(alpha = 0.6, color = "steelblue") +
geom_smooth(method = "lm", color = "black", se = FALSE) +
labs(
title = "Species Richness vs. Observation Count",
x = "Species Richness",
y = "Observation Count"
) +
theme_minimal()
ggplot(filtered_data, aes(x = first_mean, y = species_richness)) +
geom_point(alpha = 0.7, color = "blue") +
geom_smooth(method = "lm", color = "black", se = FALSE) +
labs(
title = "Land Cover Average (first_mean) vs. Species Richness",
x = "Land Cover Average (first_mean)",
y = "Species Richness"
) +
theme_minimal()
# Assuming your data is already in an sf object, which is important for spatial plotting
filtered_data_sf <- st_as_sf(filtered_data)
# Create a map with the required components
ggplot(data = filtered_data_sf) +
# Add background with first_mean as the color
geom_sf(aes(fill = first_mean), color = NA, alpha = 0.5) +  # background shading with first_mean
# Add points for park size and species richness
geom_sf(aes(size = Park_Size_, color = species_richness), alpha = 0.7) +
# Add labels for Park Address and geographical points
geom_sf_text(aes(label = Park_Addre), size = 3, color = "black", alpha = 0.7) +
# Set the color scale for species richness
scale_color_viridis_c(name = "Species Richness", option = "plasma") +
# Set the size scale for Park Size_
scale_size_continuous(name = "Park Size", range = c(1, 10)) +
# Set the fill scale for the background (first_mean)
scale_fill_viridis_c(name = "Land Cover Average (first_mean)", option = "inferno") +
# Map settings
labs(
title = "Map of Species Richness, Land Cover, and Park Size",
subtitle = "Shading = Species Richness, Background = Land Cover Average (first_mean), Size = Park Size",
x = "Longitude",
y = "Latitude"
) +
theme_minimal() +
theme(
legend.position = "bottom",
panel.grid = element_blank(),
axis.text = element_blank(),
axis.ticks = element_blank()
) +
coord_sf(datum = st_crs(filtered_data_sf))
ggplot(data = filtered_data_sf) +
# Add background with first_mean as the color
geom_sf(aes(fill = first_mean), color = NA, alpha = 0.5) +  # background shading with first_mean
# Add points for park size and species richness
geom_sf(aes(size = Park_Size_, color = species_richness), alpha = 0.7) +
# Add labels for Park Address only if Park_Addre is not missing
geom_sf_text(aes(label = ifelse(!is.na(Park_Addre), Park_Addre, "")), size = 3, color = "black", alpha = 0.7) +
# Set the color scale for species richness
scale_color_viridis_c(name = "Species Richness", option = "plasma") +
