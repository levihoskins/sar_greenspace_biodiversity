library("data.table")
library("sf")
ggplot(location_richness, aes(x = Park_Size_, y = species_richness, size = Park_Size_, color = Park_Size_Color)) +
geom_point(alpha = 0.7) +
geom_smooth(method = "lm", se = FALSE, color = "red") +
scale_x_log10() +
scale_size_continuous(
name = "Park Size",
range = c(2, 10)
) +
scale_color_manual(
values = c("Small" = "lightblue", "Large" = "lightgreen")
) +
labs(title = "Species Richness vs Park Size",
x = "Park Size",
y = "Species Richness",
color = "Park Size") +
theme_minimal()
## Check number of parks remaining after filter
unique_parks <- n_distinct(location_richness$Park_Name)
print(unique_parks) #98
# Scatterplot
ggplot(location_richness, aes(x = Park_Size_, y = species_richness)) +
geom_point(alpha = 0.7) +
scale_x_log10() +
labs(title = "Species Richness vs Park Size",
x = "Park Size",
y = "Species Richness") +
theme_minimal()
## Scatterplot with line of best fit
ggplot(location_richness, aes(x = Park_Size_, y = species_richness)) +
geom_point(alpha = 0.7) +  # Scatterplot
geom_smooth(method = "lm", se = FALSE, color = "green") +
scale_x_log10() +
labs(title = "Species Richness vs Park Size",
x = "Park Size",
y = "Species Richness") +
theme(
panel.background = element_rect(fill = "transparent", color = NA),
plot.background = element_rect(fill = "transparent", color = NA),
legend.background = element_rect(fill='transparent'),
legend.box.background = element_rect(fill='transparent')
)
# Create a new column for color based on Park_Size_
location_richness <- location_richness %>%
mutate(Park_Size_Color = ifelse(Park_Size_ < 250, "Small", "Large"))
ggplot(location_richness, aes(x = Park_Size_, y = species_richness, size = Park_Size_, color = Park_Size_Color)) +
geom_point(alpha = 0.7) +
geom_smooth(method = "lm", se = FALSE, color = "red") +
scale_x_log10() +
scale_size_continuous(
name = "Park Size",
range = c(2, 10)
) +
scale_color_manual(
values = c("Small" = "lightblue", "Large" = "lightgreen")
) +
labs(title = "Species Richness vs Park Size",
x = "Park Size",
y = "Species Richness",
color = "Park Size") +
theme_minimal()
# Line map
## Create a new column for color coding based on Park_Size_
location_richness <- location_richness %>%
mutate(Park_Size_Color = ifelse(Park_Size_ < 250, "Small", "Large"))
# Ensure the MONTH variable is a factor and set the correct order
location_richness$MONTH <- factor(location_richness$MONTH,
levels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
"Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
ordered = TRUE)
### Plot with correctly ordered months
### Plot with a continuous color scale for park size
ggplot(location_richness, aes(x = MONTH, y = species_richness, group = Park_Name, color = Park_Size_)) +
geom_line(alpha = 0.7) +
scale_color_viridis_c(option = "plasma") +
labs(title = "Species Richness by Season and Month",
x = "Month",
y = "Species Richness",
color = "Park Size") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
panel.background = element_rect(fill = "transparent", color = NA),
plot.background = element_rect(fill = "transparent", color = NA)) +
guides(color = guide_colorbar(title = "Park Size"))
# Summarize species richness per Park_Name per season
seasonal_richness <- location_richness %>%
group_by(Park_Name, Season, MONTH) %>%
summarise(avg_species_richness = mean(species_richness), .groups = "drop")
### Location_Richness_Seasonality
location_richness_area_season <- final_shapefile_clean %>%
group_by(Park_Name, Park_Size_, MONTH) %>%
summarise(species_richness = n_distinct(COMMON), .groups = 'drop') %>%
mutate(
Season = case_when(
MONTH %in% c("Mar", "Apr", "May") ~ "SM",
MONTH %in% c("Jun", "Jul") ~ "S",
MONTH %in% c("Dec", "Jan", "Feb") ~ "W",
MONTH %in% c("Aug", "Sep", "Oct", "Nov") ~ "FM"
)
)
### Graphing density
ggplot(location_richness_area_season, aes(x = Park_Size_, fill = Season, color = Season)) +
geom_histogram(aes(y = ..density..), bins = 30, alpha = 0.3, position = "identity") +
geom_density(size = 1.2) +
scale_color_manual(values = c("SM" = "blue", "S" = "green", "FM" = "orange", "W" = "red")) +
scale_fill_manual(values = c("SM" = "blue", "S" = "green", "FM" = "orange", "W" = "red")) +
labs(title = "Species Richness by Park Size Across Seasons",
x = "Park Size",
y = "Density",
fill = "Season",
color = "Season") +
theme_minimal()
## Number of sites
length(unique(location_richness$Park_Name))
### Graphing density
ggplot(location_richness_area_season, aes(x = Park_Size_, fill = Season, color = Season)) +
geom_histogram(aes(y = after_stat(density)), bins = 30, alpha = 0.3, position = "identity") +
geom_density(size = 1.2) +
scale_color_manual(values = c("SM" = "blue", "S" = "green", "FM" = "orange", "W" = "red")) +
scale_fill_manual(values = c("SM" = "blue", "S" = "green", "FM" = "orange", "W" = "red")) +
labs(title = "Species Richness by Park Size Across Seasons",
x = "Park Size",
y = "Density",
fill = "Season",
color = "Season") +
theme_minimal()
### Graphing density
ggplot(location_richness_area_season, aes(x = Park_Size_, fill = Season)) +
geom_histogram(aes(y = after_stat(density)), bins = 30, alpha = 0.5, color = "black") +
geom_density(aes(y = after_stat(density)), size = 1.2, color = "black") +
scale_fill_manual(values = c("SM" = "blue", "S" = "green", "FM" = "orange", "W" = "red")) +
facet_wrap(~ Season, scales = "free") +
labs(title = "Species Richness by Park Size Across Seasons",
x = "Park Size",
y = "Density",
fill = "Season") +
theme_minimal()
### Graphing density
ggplot(location_richness_area_season, aes(x = Park_Size_, y = species_richness, fill = Season)) +
geom_col(position = "dodge", alpha = 0.7) +
scale_fill_manual(values = c("SM" = "blue", "S" = "green", "FM" = "orange", "W" = "red")) +
facet_wrap(~ Season, scales = "free") +
labs(title = "Species Richness by Park Size Across Seasons",
x = "Park Size",
y = "Species Richness",
fill = "Season") +
theme_minimal()
### Graphing density
ggplot(location_richness_area_season, aes(x = Park_Size_, y = species_richness, color = Season, group = Season)) +
geom_line(size = 1.2) +  # Plot lines
geom_point(size = 3, alpha = 0.6) +  # Add points to each line for clarity
scale_color_manual(values = c("SM" = "blue", "S" = "green", "FM" = "orange", "W" = "red")) +
