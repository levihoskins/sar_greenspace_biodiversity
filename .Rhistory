all_points$year <- lubridate::year(all_points$OBSERVATION.DAT)
# Convert date column to year format
all_points$year <- lubridate::year(all_points$OBSERVATION.DATE)
# Convert date column to year format
all_points$year <- lubridate::year(all_points$OBSERVATION.DATE)
View(all_points)
View(br_sf_filtered)
# Count checklists per greenspace per month
greenspace_checklist_counts_monthly <- all_points %>%
group_by(Park_Name, MONTH) %>%
summarise(checklist_count = n(), .groups = "drop")
View(all_points)
## Merge all point datasets
