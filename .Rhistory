# Read in packages
library("dplyr")
library("sf")
library("raster")
library("lubridate")
library("readr")
library("rnaturalearth")
library("rnaturalearthdata")
library("concaveman")
library("ggspatial")
# Read in packages
library("ggplot2")
library("dplyr")
library("readr")
library("tidyr")
library("vegan")
library("lubridate")
library("data.table")
library("sf")
library("ggspatial")
library("hrbrthemes")
library("viridis")
# Read the shapefile and remove rows with NAs
final_shapefile_clean <- st_read("Data/Polygons/final_shapefile_clean_saved.shp")
# Calculate via park, size, month
location_richness <- final_shapefile_clean %>%
group_by(Park_Name, Park_Size_, MONTH) %>%
mutate(species_richness = n_distinct(COMMON)) %>%
ungroup()
location_richness <- location_richness %>%
filter(Park_Size_ <= 1500)
# Line map
## Create a new column for color coding based on Park_Size_
location_richness <- location_richness %>%
mutate(Park_Size_Color = ifelse(Park_Size_ < 250, "Small", "Large"))
# Ensure the MONTH variable is a factor and set the correct order
location_richness$MONTH <- factor(location_richness$MONTH,
levels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
"Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
ordered = TRUE)
### Bubble plot
### To show month, species richness, and park size all in one
location_richness %>%
arrange(desc(species_richness)) %>%
ggplot(aes(x = MONTH, y = species_richness, group = Park_Name, color = Park_Size_t)) +
geom_point(alpha=0.5, shape=21, color="black") +
scale_size(range = c(.1, 24), name="Greenspace Size") +
scale_fill_viridis(discrete=TRUE, guide=FALSE, option="A") +
theme_ipsum() +
theme(legend.position="bottom") +
ylab("Species Richness") +
xlab("Month") +
theme(legend.position = "none")
location_richness %>%
arrange(desc(species_richness)) %>%
ggplot(aes(x = MONTH, y = species_richness, group = Park_Name, color = Park_Size_)) +
geom_point(alpha=0.5, shape=21, color="black") +
scale_size(range = c(.1, 24), name="Greenspace Size") +
scale_fill_viridis(discrete=TRUE, guide=FALSE, option="A") +
theme_ipsum() +
theme(legend.position="bottom") +
ylab("Species Richness") +
xlab("Month") +
theme(legend.position = "none")
location_richness %>%
arrange(desc(species_richness)) %>%
ggplot(aes(x = MONTH, y = Park_Size_, group = Park_Name, color = species_richness)) +
geom_point(alpha=0.5, shape=21, color="black") +
scale_size(range = c(.1, 24), name="Greenspace Size") +
scale_fill_viridis(discrete=TRUE, guide=FALSE, option="A") +
theme_ipsum() +
theme(legend.position="bottom") +
ylab("Species Richness") +
xlab("Month") +
theme(legend.position = "none")
### Bubble plot
### To show month, species richness, and park size all in one
ggplot(location_richness, aes(x=MONTH, y=Park_Size_, size = species_richness)) +
geom_point(alpha=0.7)
### Bubble plot
### To show month, species richness, and park size all in one
ggplot(location_richness, aes(x=MONTH, y=species_richness, size = Park_Size_)) +
geom_point(alpha=0.7)
location_richness %>%
arrange(desc(species_richness)) %>%
