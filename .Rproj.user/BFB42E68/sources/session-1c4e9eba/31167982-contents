# Read in packages
library("ggplot2")
library("dplyr")
library("readr")
library("tidyr")
library("vegan")
library("lubridate")
library("data.table")
library("sf")


##########################################
## DO NOT FORGET PARK_SIZE_ is in HECTARES
##########################################

# Read the shapefile and remove rows with NAs
final_shapefile_clean <- st_read("Data/Polygons/final_shapefile_clean.shp")

# Calculate via park, size, month
location_richness <- final_shapefile_clean %>%
  group_by(ParkNameX, Park_Size_, MONTH) %>%
  summarise(species_richness = n_distinct(COMMON), .groups = 'drop')

location_richness <- location_richness %>%
  filter(Park_Size_ <= 1500)

ggplot() +
  geom_sf(data = location_richness, fill = "lightblue", color = "black") +
  theme_minimal() +
  labs(title = "Filtered Shapefile with Points")
ggsave('Transparent_Greenspaces.png', bg='transparent')

## Check number of parks remaining after filter
unique_parks <- n_distinct(location_richness$ParkNameX)
print(unique_parks) #125

#################################
### Preliminary Graphs for Poster
#################################

# Scatterplot
ggplot(location_richness, aes(x = Park_Size_, y = species_richness)) +
  geom_point(alpha = 0.7) +
  scale_x_log10() +
  labs(title = "Species Richness vs Park Size",
       x = "Park Size",
       y = "Species Richness") +
  theme_minimal()

## Scatterplot with line of best fit
ggplot(location_richness, aes(x = Park_Size_, y = species_richness)) +
  geom_point(alpha = 0.7) +  # Scatterplot
  geom_smooth(method = "lm", se = FALSE, color = "green") +
  scale_x_log10() +
  labs(title = "Species Richness vs Park Size",
       x = "Park Size",
       y = "Species Richness") +
  theme(
    panel.background = element_rect(fill = "transparent", color = NA),  
    plot.background = element_rect(fill = "transparent", color = NA),
    legend.background = element_rect(fill='transparent'),
    legend.box.background = element_rect(fill='transparent')
  )
ggsave('Transparent_Scatterplot.png', bg='transparent')

# Create a new column for color based on Park_Size_
location_richness <- location_richness %>%
  mutate(Park_Size_Color = ifelse(Park_Size_ < 250, "Small", "Large"))

ggplot(location_richness, aes(x = Park_Size_, y = species_richness, size = Park_Size_, color = Park_Size_Color)) +
  geom_point(alpha = 0.7) + 
  geom_smooth(method = "lm", se = FALSE, color = "red") +
  scale_x_log10() +
  scale_size_continuous(
    name = "Park Size", 
    range = c(2, 10)
  ) +
  scale_color_manual(
    values = c("Small" = "lightblue", "Large" = "lightgreen")
  ) +
  labs(title = "Species Richness vs Park Size",
       x = "Park Size",
       y = "Species Richness",
       color = "Park Size") +
  theme_minimal()

# Line map
## Create a new column for color coding based on Park_Size_
location_richness <- location_richness %>%
  mutate(Park_Size_Color = ifelse(Park_Size_ < 250, "Small", "Large"))

# Ensure the MONTH variable is a factor and set the correct order
location_richness$MONTH <- factor(location_richness$MONTH, 
                                  levels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun", 
                                             "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
                                  ordered = TRUE)

### Plot with correctly ordered months
### Plot with a continuous color scale for park size
ggplot(location_richness, aes(x = MONTH, y = species_richness, group = ParkNameX, color = Park_Size_)) +
  geom_line(alpha = 0.7) +
  scale_color_viridis_c(option = "plasma") +
  labs(title = "Species Richness by Season and Month",
       x = "Month",
       y = "Species Richness",
       color = "Park Size") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1),
        panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA)) +
  guides(color = guide_colorbar(title = "Park Size"))
ggsave('Transparent_LineMap_Log.png', bg = 'transparent')

#### Add a line of best fit
ggplot(location_richness, aes(x = MONTH, y = species_richness, group = ParkNameX, color = Park_Size_)) +
  geom_line(alpha = 0.7) +
  geom_smooth(aes(group = 1), method = "loess", se = FALSE, color = "black", linewidth = 1) +  # Trend line
  scale_color_viridis_c(option = "plasma") +
  labs(title = "Species Richness by Season and Month",
       x = "Month",
       y = "Species Richness",
       color = "Park Size") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1),
        panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA)) +
  guides(color = guide_colorbar(title = "Park Size"), level=c(0.95,0.96))
ggsave('Transparent_LineMap_Line_Best.png', bg = 'transparent')

