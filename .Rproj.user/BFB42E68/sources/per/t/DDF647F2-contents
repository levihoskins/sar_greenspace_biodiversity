# Read in packages
library("ggplot2")
library("dplyr")
library("readr")
library("tidyr")
library("vegan")
library("lubridate")
library("data.table")
library("sf")
library("ggspatial")
library("hrbrthemes")
library("viridis")

##########################################
## DO NOT FORGET PARK_SIZE_ is in HECTARES
##########################################

# Read the shapefile and remove rows with NAs
final_shapefile_clean <- st_read("Data/Polygons/final_shapefile_clean_saved.shp")

# Calculate via park, size, month
location_richness <- final_shapefile_clean %>%
  group_by(Park_Name, Park_Size_, MONTH) %>%
  mutate(species_richness = n_distinct(COMMON)) %>%
  ungroup()

location_richness <- location_richness %>%
  filter(Park_Size_ <= 1500)

ggplot() +
  annotation_map_tile(type = "cartolight") +
  geom_sf(data = location_richness, fill = "lightblue", color = "black") +
  theme_minimal() +
  labs(title = "Filtered Greenspaces")

ggplot() +
  annotation_map_tile(type = "cartolight", zoomin = 0) +
  geom_sf(data = location_richness, fill = "#69b3a2", color = "lightgreen", size = 0.5, alpha = 0.8) +
  labs(title = "Urban Greenspaces in the Study Area") +
  theme(
    plot.title = element_text(size = 16, face = "bold", hjust = 0.5),
    plot.background = element_rect(fill = "transparent", color = NA),
    panel.background = element_rect(fill = "transparent", color = NA)
  )

ggsave('Transparent_Greenspaces.png', bg='transparent')

## Check number of parks remaining after filter
unique_parks <- n_distinct(location_richness$Park_Name)
print(unique_parks) #97

