# Line map
### Ensure the MONTH variable is a factor and set the correct order
location_richness$MONTH <- factor(location_richness$MONTH, 
                                  levels = c("Jan", "Feb", "Mar", "Apr", "May", "Jun", 
                                             "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
                                  ordered = TRUE)

### Plot with correctly ordered months
### Plot with a continuous color scale for park size
ggplot(location_richness, aes(x = MONTH, y = species_richness, group = Park_Name, color = log(Park_Size_))) +
  geom_line(alpha = 0.7) +
  scale_color_viridis_c(option = "viridis") +
  labs(title = "Species Richness by Season and Month",
       x = "Month",
       y = "Species Richness",
       color = "Park Size") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1),
        panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA)) +
  guides(color = guide_colorbar(title = "Park Size"))
ggsave('Transparent_LineMap_Log.png', bg = 'transparent')

#### Add a line of best fit
ggplot(location_richness, aes(x = MONTH, y = species_richness, group = Park_Name, color = log(Park_Size_))) +
  geom_line(alpha = 0.7) +
  geom_smooth(aes(group = 1), method = "loess", se = FALSE, color = "black", linewidth = 1) +  # Trend line
  scale_color_viridis_c(option = "plasma") +
  labs(title = "Species Richness by Season and Month",
       x = "Month",
       y = "Species Richness",
       color = "Log of Park Size") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1),
        panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA)) +
  guides(color = guide_colorbar(title = "Log of Park Size"))
ggsave('Transparent_LineMap_Line_Best.png', bg = 'transparent')

### Bubble plot
### To show month, species richness, and park size all in one
ggplot(location_richness, aes(x=MONTH, y=species_richness, size = Park_Size_)) +
  geom_point(alpha=0.7)

location_richness %>%
  arrange(desc(species_richness)) %>%
  ggplot(aes(x = MONTH, y = species_richness, fill = Park_Size_)) +
  geom_point(alpha = 0.7, shape = 21, color = "black", size = 3) +  
  scale_size(range = c(1, 12), name = "Greenspace Size") +
  scale_fill_viridis_c(option = "A", name = "Park Size")
  theme_ipsum() +
  theme(legend.position = "bottom") +
  ylab("Species Richness") +
  xlab("Month")

ggsave('Transparent_Bubble_Plot.png', bg = 'transparent')

### Location_Richness_Seasonality
location_richness_area_season <- final_shapefile_clean %>%
  group_by(Park_Name, Park_Size_, MONTH) %>%
  summarise(species_richness = n_distinct(COMMON), .groups = 'drop') %>%
  mutate(
    Season = case_when(
      MONTH %in% c("Mar", "Apr", "May") ~ "Spring Migration", 
      MONTH %in% c("Jun", "Jul") ~ "Breeding",                                    
      MONTH %in% c("Dec", "Jan", "Feb") ~ "Overwintering",                              
      MONTH %in% c("Aug", "Sep", "Oct", "Nov") ~ "Fall Migration" 
    )
  )

### Graphing Species_richness per season of full-annual cycle
location_richness_area_season %>%
  ggplot(aes(x = log(Park_Size_), y = species_richness, color = Season)) +
  geom_point(alpha = 0.6, size = 3) +  
  geom_smooth(method = "lm", se = F, size = 1.2) + 
  scale_color_manual(values = c("Spring Migration" = "#00FF00", 
                                "Breeding" = "#800080",
                                "Fall Migration" = "#FFFF00", 
                                "Overwintering" = "#1E90FF")) +
  facet_wrap(~ factor(Season, levels = c("Spring Migration", "Breeding", "Fall Migration", "Overwintering")), scales = "free") +  
  labs(title = "Species Richness across Park Size through Full-annual Cycle",
       x = "log(Park Size)",
       y = "Species Richness",
       color = "Season") +
  theme_minimal()

location_richness_area_season %>%
  ggplot(aes(x = log(Park_Size_), y = species_richness, color = Season)) +
  geom_point(alpha = 0.6, size = 3, color = "black") +  # Set points to black
  geom_smooth(method = "lm", se = F, size = 1.2) +  # Lines will retain season color
  scale_color_manual(values = c("Spring Migration" = "#00FF00",  # Vivid Green for Spring
                                "Breeding" = "#800080",  # Deep Purple for Breeding
                                "Fall Migration" = "#FFFF00",  # Bright Yellow for Fall
                                "Overwintering" = "#1E90FF")) +  # Vivid Blue for Overwintering
  facet_wrap(~ factor(Season, levels = c("Spring Migration", "Breeding", "Fall Migration", "Overwintering")), scales = "free") +  
  labs(title = "Species Richness across Park Size through Full-annual Cycle",
       x = "log(Park Size)",
       y = "Species Richness",
       color = "Season") +
  theme_minimal()
ggsave('_Log_Transparent_Species_Richness_Seasonality.png', bg = 'transparent')

